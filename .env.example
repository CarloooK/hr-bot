# HR Bot 环境变量配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# DeepSeek API（必填）
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 钉钉应用凭据（与钉钉集成则必填）
# 从钉钉开放平台 https://open.dingtalk.com 创建应用后获取
DINGTALK_APP_KEY=dingxxxxxxxxxxxxxxxx
DINGTALK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ngrok token（可选，开发模式 ./run.sh dev 时需要）
# 从 https://dashboard.ngrok.com 获取
NGROK_AUTH_TOKEN=
